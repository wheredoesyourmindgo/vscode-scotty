{
  "name": "vscode-scotty",
  "displayName": "Beam Me Up, Scotty!",
  "description": "Jump to and select the next or previous occurrence of any characters, like clever-f.vim.",
  "categories": [
    "Keymaps"
  ],
  "keywords": [
    "jump",
    "navigation",
    "selection",
    "productivity",
    "case-insensitive",
    "clever-f",
    "search",
    "smart-navigation"
  ],
  "license": "MIT",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "scotty.jumpForward",
        "title": "Jump Forward",
        "category": "Scotty"
      },
      {
        "command": "scotty.jumpBackward",
        "title": "Jump Backward",
        "category": "Scotty"
      },
      {
        "command": "scotty.selectForward",
        "title": "Select Forward",
        "category": "Scotty"
      },
      {
        "command": "scotty.selectBackward",
        "title": "Select Backward",
        "category": "Scotty"
      },
      {
        "command": "scotty.jumpForwardCaseInsensitive",
        "title": "Jump Forward (Case-Insensitive)",
        "category": "Scotty"
      },
      {
        "command": "scotty.jumpBackwardCaseInsensitive",
        "title": "Jump Backward (Case-Insensitive)",
        "category": "Scotty"
      },
      {
        "command": "scotty.selectForwardCaseInsensitive",
        "title": "Select Forward (Case-Insensitive)",
        "category": "Scotty"
      },
      {
        "command": "scotty.selectBackwardCaseInsensitive",
        "title": "Select Backward (Case-Insensitive)",
        "category": "Scotty"
      }
    ],
    "keybindings": [
      {
        "command": "scotty.jumpForward",
        "key": "ctrl+0",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.jumpBackward",
        "key": "ctrl+7",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.selectForward",
        "key": "ctrl+shift+0",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.selectBackward",
        "key": "ctrl+shift+7",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.jumpForwardCaseInsensitive",
        "key": "ctrl+alt+0",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.jumpBackwardCaseInsensitive",
        "key": "ctrl+alt+7",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.selectForwardCaseInsensitive",
        "key": "ctrl+alt+shift+0",
        "when": "editorTextFocus"
      },
      {
        "command": "scotty.selectBackwardCaseInsensitive",
        "key": "ctrl+alt+shift+7",
        "when": "editorTextFocus"
      }
    ]
  },
  "publisher": "wheredoesyourmindgo",
  "repository": {
    "type": "git",
    "url": "https://github.com/wheredoesyourmindgo/vscode-scotty"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "format": "prettier --config .prettierrc --write './src/**/*.ts'"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "eslint": "8.57.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "homepage": "https://github.com/wheredoesyourmindgo/vscode-scotty#readme",
  "bugs": {
    "url": "https://github.com/wheredoesyourmindgo/vscode-scotty/issues"
  }
}
